{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/readme-reminder.sh",
            "if": "Bash(git commit*)",
            "timeout": 10,
            "statusMessage": "Checando se o README precisa de atualização…"
          }
        ]
      }
    ]
  }
}
